# Installed to /etc/caddy/Caddyfile by deploy/install.sh. DEVDASH_DOMAIN comes from a systemd drop-in;
# /etc/caddy/devdash-tls.caddy is generated (Cloudflare origin cert, or `tls internal` until it exists).

{$DEVDASH_DOMAIN} {
	import /etc/caddy/devdash-tls.caddy
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8787
	}
	handle /.well-known/devdash.json {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		root * /opt/devdash/current/apps/web/dist
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
