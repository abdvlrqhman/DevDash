[Unit]
Description=DevDash server
After=network.target

[Service]
User=devdash
Group=devdash
EnvironmentFile=/etc/devdash/devdash.env
WorkingDirectory=/opt/devdash/current
ExecStart=/usr/bin/node apps/server/src/main.ts
Restart=on-failure
RestartSec=2
UMask=0077

# Hardening. Phase 2 revisits NoNewPrivileges (the root helper runs through sudo).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/devdash
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
