{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDash",
  "version": "0.1.0",
  "identifier": "io.github.abdvlrqhman.devdash",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src https:; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DevDash contributors",
    "shortDescription": "Your team's DevDash space",
    "longDescription": "Claude Code, terminals, tasks and builds on your team's own server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
